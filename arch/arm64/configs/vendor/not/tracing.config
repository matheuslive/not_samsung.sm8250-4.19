# Restore the minimum tracing needed by Android's bpfloader.
#
# not_kernel turns the whole tracing subsystem off (TRACING_SUPPORT defaults to
# n), which drops CONFIG_BPF_EVENTS. Without it the bpfloader cannot pin the
# eBPF programs under /sys/fs/bpf, so libnetd_updatable_init aborts, netd dies,
# system_server crashes and zygote restarts forever - the device never boots.
#
# FUNCTION_TRACER stays off, so the expensive part of ftrace is not paid for.
CONFIG_FTRACE=y
CONFIG_ENABLE_DEFAULT_TRACERS=y

# The android_vh_* hooks are tracepoints. With TRACEPOINTS enabled their call
# sites become real references, so the translation unit that defines them has
# to be built or vmlinux fails to link.
CONFIG_ANDROID_VENDOR_HOOKS=y
